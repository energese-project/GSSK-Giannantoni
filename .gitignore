# GSSK Build Artifacts
bin/
lib/
dist/
tests/results/

# Temporary deployment folder
/public/

# Object files and libraries
*.o
*.a
*.so
*.dylib
*.exe

# Emscripten generated files
bin/*.js.mem
bin/*.wasm

# IDE and system files
.DS_Store
.vscode/
.idea/
.cache/

# Node.js
node_modules/
docs/.vitepress/dist/

# Swift Package Manager
.build/
.swiftpm/

# Ensure dist/ artifacts are tracked. Anchored to the root: unanchored, it
# re-included every directory named dist, including docs/.vitepress/dist.
!/dist/

# AI assistant memory
.claude/

# Python bytecode
__pycache__/
*.pyc

# Python demo temp files
/tmp/gssk_demo_*.csv

# Giannantoni simulator output
/output.json
/simulation_output.csv
/output.seed.json
/out.txt

# Reference papers are cited, not redistributed: several are Elsevier or
# Academic Press and this repository is public.
docs/*.pdf
tools/

# Third-party sources that are not openly licensed (text extracts, OCR,
# page renders). Kept locally beside docs/sources/cc-by/; see docs/sources/README.md.
docs/sources/local/

# Coverage builds and reports (make coverage-report, make coverage-gia)
coverage/
*.gcda
*.gcno
